generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Club {
  id              Int     @id @default(autoincrement())
  name            String
  is_active       Boolean @default(true)
  region          String
  address         String?
  contact_email   String?
  members         User[]  @relation("ClubMemberships")
  teams           Team[]
}

model Role {
  id    Int    @id @default(autoincrement())
  role  String @unique
  users User[]
}

model User {
  id            Int              @id @default(autoincrement())
  name          String
  email         String           @unique
  password_hash String
  club_id       Int?
  roles         Role[]
  teams         TeamMembership[]
  refresh_tokens  RefreshToken[] @relation("UserRefreshTokens")

  club Club? @relation("ClubMemberships", fields: [club_id], references: [id])
}

model Team {
  id             Int              @id @default(autoincrement())
  club_id        Int
  name           String
  is_active      Boolean          @default(true)
  members        TeamMembership[]
  matchesAsTeam1 Match[]          @relation("MatchTeam1")
  matchesAsTeam2 Match[]          @relation("MatchTeam2")
  matchesWon     Match[]          @relation("MatchWinnerTeam")

  club Club @relation(fields: [club_id], references: [id])

  tournamentTeams TournamentTeam[]

  @@unique([club_id, name])
}

model TeamMembership {
  id        Int       @id @default(autoincrement())
  team_id   Int
  user_id   Int
  from_date DateTime
  to_date   DateTime?

  team Team @relation(fields: [team_id], references: [id])
  user User @relation(fields: [user_id], references: [id])

  @@unique([team_id, user_id, from_date])
}

model Tournament {
  id        Int              @id @default(autoincrement())
  season    String
  name      String
  divisions Division[]
  matches   Match[]
  teams     TournamentTeam[]
  dates     TournamentDate[]

  @@unique([name, season])
}

model Match {
  id             Int      @id @default(autoincrement())
  tournament_id  Int
  division_id    Int?
  team1_id       Int
  team1_score    Int?
  team2_id       Int
  team2_score    Int?
  winner_team_id Int?
  field          Int
  match_date     DateTime

  tournament  Tournament @relation(fields: [tournament_id], references: [id])
  team1       Team       @relation("MatchTeam1", fields: [team1_id], references: [id])
  team2       Team       @relation("MatchTeam2", fields: [team2_id], references: [id])
  winner_team Team?      @relation("MatchWinnerTeam", fields: [winner_team_id], references: [id])
}

model Division {
  id            Int    @id @default(autoincrement())
  tournament_id Int
  name          String

  teams      TournamentTeam[]
  tournament Tournament       @relation(fields: [tournament_id], references: [id])

  @@unique([tournament_id, name])
}

model TournamentTeam {
  id            Int @id @default(autoincrement())
  tournament_id Int
  team_id       Int
  division_id   Int

  tournament Tournament @relation(fields: [tournament_id], references: [id])
  team       Team       @relation(fields: [team_id], references: [id])
  division   Division   @relation(fields: [division_id], references: [id])

  @@unique([tournament_id, team_id])
  @@unique([team_id, division_id])
}

model TournamentDate {
  id            Int      @id @default(autoincrement())
  tournament_id Int
  date          DateTime

  tournament Tournament @relation(fields: [tournament_id], references: [id])
}

model RefreshToken {
  id Int @id @default(autoincrement())
  token_hash String @unique
  user_id Int
  device_id String
  created_at DateTime
  expires_at DateTime

  user User @relation("UserRefreshTokens", fields: [user_id], references: [id])

  @@unique([user_id, device_id])
}