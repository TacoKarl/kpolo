meta {
  name: Register
  type: graphql
  seq: 3
}

post {
  url: http://localhost:3000/graphql
  body: graphql
  auth: inherit
}

body:graphql {
  mutation Register($email: String!, $name: String!, $password: String!) {
    register(email: $email, name: $name, password: $password) {
      id
      name
      email
    }
  }
}

body:graphql:vars {
  {
    "email": "olros.dev@proton.me",
    "name": "Oliver Diangson Rosenkilde",
    "password": "Test1234"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
